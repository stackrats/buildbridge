{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "buildbridge",
    "mainBinaryName": "buildbridge-desktop",
    "version": "0.1.0",
    "identifier": "dev.buildbridge.desktop",
    "build": {
        "beforeDevCommand": "vp dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "vp run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "buildbridge",
                "width": 1180,
                "height": 800,
                "minWidth": 900,
                "minHeight": 620,
                "backgroundColor": "#09090b",
                "visible": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws: wss:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/128x128@2x.png",
            "icons/128x128.png",
            "icons/64x64.png",
            "icons/32x32.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
